# Copy this file to ".env" and fill in your key.
# Get a free key at https://steamcommunity.com/dev/apikey
STEAM_API_KEY=PASTE_YOUR_STEAM_WEB_API_KEY_HERE

# Optional
PORT=3000
# Max friends analysed for the friend leaderboard (each friend = 2 Steam calls)
MAX_FRIENDS=60
# Requests allowed per IP per minute on /api
RATE_LIMIT_PER_MIN=120
# Restrict CORS if the frontend is hosted on another domain, e.g. https://steamtrack.example.com
CORS_ORIGIN=*
# Global leaderboard: extra SteamID64s to start with (comma separated) and max members
SEED_IDS=76561197960287930
MAX_BOARD=150
